{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "role-provider-service values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roleProviderService",
    "ingress"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Injected by Helm into every subchart. Must be tolerated here, or this chart cannot be used as a dependency at all, because additionalProperties is false."
    },
    "enabled": {
      "type": "boolean",
      "description": "Dependency condition of the cloud-self-service umbrella chart, which passes it down into this namespace — so it has to be allowed here for the same reason global does. A standalone install ignores it."
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Pins the resource base name. The umbrella chart sets this so adopting these releases does not rename every object."
    },
    "roleProviderService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "version",
        "hostname",
        "replicas",
        "port",
        "db",
        "api"
      ],
      "if": {
        "properties": {
          "existingSecret": {
            "const": ""
          }
        }
      },
      "then": {
        "properties": {
          "api": {
            "properties": {
              "tokens": {
                "minLength": 32,
                "not": {
                  "const": "change-me"
                }
              }
            }
          }
        }
      },
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "version": {
          "type": "string",
          "description": "Image tag. Empty falls back to the chart appVersion, which is how a pinned chart version pins the image."
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "serviceTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "groupRelations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "db": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectionString"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "memory",
                "postgres"
              ]
            },
            "connectionString": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokens"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "production",
                "development"
              ]
            },
            "tokens": {
              "type": "string",
              "description": "Read-only API tokens, comma-separated. Only used when the chart creates its own Secret; then it must be set to a real secret (at least 32 characters, not the old placeholder change-me)."
            },
            "writeTokens": {
              "type": "string"
            },
            "corsAllowedOrigins": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https?://[^/]+$"
              }
            }
          }
        },
        "keycloak": {
          "type": "object",
          "additionalProperties": false,
          "description": "Keycloak source: groups derived from user attributes. Empty realmUrl disables it. The client secret is the key keycloak-client-secret in the chart's Secret (or existingSecret).",
          "properties": {
            "realmUrl": {
              "type": "string",
              "pattern": "^$|^https?://.+/realms/[^/]+$"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string",
              "description": "Only used when the chart creates its own Secret."
            },
            "syncSchedule": {
              "type": "string"
            },
            "mapping": {
              "type": "object",
              "description": "The attribute-to-group rules (see the role-provider README), passed on as JSON."
            }
          }
        },
        "localSourceName": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the source that holds the groups maintained through the API and the self-service UI, shown next to them (e.g. \"ZWR\")."
        },
        "adoptSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "CSV/LDIF sources whose groups pass to the local source at startup; each is deleted afterwards. A no-op once done."
        },
        "adminTokens": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(user|group):.+$"
          },
          "description": "Tokens that maintain every local group, create and delete groups, and may act on behalf of another person (e.g. group:root-admin)."
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "description": "Identity provider of the self-service UI. With issuerUrl set, people signed in there maintain the groups they manage under /v1/manage; empty leaves that out.",
          "properties": {
            "issuerUrl": {
              "type": "string",
              "pattern": "^$|^https?://.+"
            },
            "clientId": {
              "type": "string"
            },
            "jwksUrl": {
              "type": "string",
              "pattern": "^$|^https?://.+"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
