{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "role-provider-service values",
  "type": "object",
  "additionalProperties": false,
  "required": ["roleProviderService", "ingress"],
  "properties": {
    "roleProviderService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "version", "hostname", "replicas", "port", "db", "api"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "version": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "replicas": { "type": "integer", "minimum": 0 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "serviceTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "existingSecret": { "type": "string" },
        "db": {
          "type": "object",
          "additionalProperties": false,
          "required": ["connectionString"],
          "properties": {
            "type": { "type": "string", "enum": ["memory", "postgres"] },
            "connectionString": { "type": "string", "minLength": 1 }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens"],
          "properties": {
            "mode": { "type": "string", "enum": ["production", "development"] },
            "tokens": { "type": "string", "minLength": 1 },
            "writeTokens": { "type": "string" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
